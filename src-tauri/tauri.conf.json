{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elysium",
  "version": "0.3.0",
  "identifier": "com.ooberguts.elysium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Elysium",
        "width": 1280,
        "height": 820,
        "minWidth": 850,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost jellyfin: http://jellyfin.localhost blob: http://127.0.0.1:*; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "shortDescription": "Your music and video collection, beautifully in order.",
    "resources": ["resources/bin/*", "resources/demo/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQkUxODBBQjQzRjMyRTgKUldUb01qKzBDaGkrMHhsNVllbUFORTlPajY0ZWR1REtVeE9hLy9sQ2d3bG1LMmtPNWhFQm44ajkK",
      "endpoints": ["https://github.com/ooberguts/Elysium/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
